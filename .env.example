# =========================================================
# TEMANSPACE.ID Environment Variables Example
# Salin file ini ke .env untuk pengembangan lokal.
# JANGAN PERNAH meng-commit file .env atau mengisi secret asli di file ini.
# =========================================================

# Database connection (SQLite lokal secara default)
DATABASE_URL="file:./dev.db"

# Session signing secret (gunakan string acak minimal 32 karakter)
AUTH_SESSION_SECRET="replace-with-secure-random-64-char-hex-string"

# App public base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Konfigurasi akun admin awal untuk script seed (hanya untuk inisialisasi lokal/deployment)
SEED_ADMIN_EMAIL="admin@temanspace.local"
SEED_ADMIN_PASSWORD="replace-with-strong-admin-password"
SEED_ADMIN_NAME="Pengelola TEMANSPACE.ID"

# Rate limiting login
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
